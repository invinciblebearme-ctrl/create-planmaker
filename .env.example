# 전북 AI (Baze API Gateway) 연동 환경변수 설정 예시
# 새로 발급받은 API 키를 .env.local 파일에 설정하거나, 웹 화면의 [⚙️ API 키 설정] 창에서 바로 입력할 수 있습니다.
VITE_JEONBUK_AI_API_KEY="YOUR_API_KEY"
VITE_JEONBUK_AI_BASE_URL="https://api.baze.co/v1/gateway"
VITE_JEONBUK_AI_MODEL="claude-sonnet-5"
VITE_JEONBUK_AI_CHATBOT_ID=""
VITE_CHATBOT_API_URL="https://create.allforedu.kr/api/chatbot"

